# OpenRouter (OpenAI-compatible API). Never commit a real API key.
# Create a key at https://openrouter.ai/keys and place it only in .env.
OPENROUTER_API_KEY=sk-or-v1-your-key-here
LLM_BASE_URL=https://openrouter.ai/api/v1
# Pinned revision for reproducible paper experiments.
LLM_MODEL_NAME=deepseek/deepseek-v4-flash-0731
# Cost-efficient 8B comparator used in Experiments 1--3.
LLM_COMPARISON_MODEL_NAME=qwen/qwen3-8b
LLM_TEMPERATURE=0.8
LLM_MAX_TOKENS=2200
LLM_DISABLE_REASONING=true
LLM_CONCURRENCY=6
OPENROUTER_HTTP_REFERER=
OPENROUTER_APP_TITLE=DEEDY Thai Campaign Simulation

# ===== ZEP记忆图谱配置 =====
# 每月免费额度即可支撑简单使用：https://app.getzep.com/
ZEP_API_KEY=your_zep_api_key_here

# ===== 加速 LLM 配置（可选）=====
# 注意如果不使用加速配置，env文件中就不要出现下面的配置项
LLM_BOOST_API_KEY=
LLM_BOOST_BASE_URL=
LLM_BOOST_MODEL_NAME=
